TELEGRAM_BOT_TOKEN=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key separately. Losing it makes stored accounts unreadable.
TOKEN_ENCRYPTION_KEY=
# Keep false for invite-only access; true allows any Telegram user to use their own account.
PUBLIC_ACCESS=false
ALLOWED_USER_IDS=
# Required for /connect. Must be externally reachable and accepted by Swiggy registration.
OAUTH_CALLBACK_URL=
OAUTH_BIND_HOST=127.0.0.1
OAUTH_PORT=8765
DATABASE_PATH=instadeals.db
POLL_SECONDS=300
REQUEST_GAP_SECONDS=3
